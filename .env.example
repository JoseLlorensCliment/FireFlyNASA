# Flame Intelligence — copy to .env and fill in. NEVER commit .env.
#
# The AI assistant uses TWO different models:
#   1. LLM (writes the chatbot / report answers) ..... Groq API            -> GROQ_API_KEY (the only key you need)
#   2. Embeddings (turn the question into a vector to SEARCH the NASA corpus)
#      fastembed BAAI/bge-small-en-v1.5, runs on the machine that runs the backend. The documents are already
#      embedded: the FAISS index is in the repository (data/processed/rag/). On first use the ~65 MB model is
#      downloaded once into data/processed/models/.

# --- 1. LLM: Groq (free plan) — https://console.groq.com/keys ---
LLM_PROVIDER=groq
GROQ_API_KEY=
# Free-plan models with JSON output (verified 14 Nov 2026): openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high — low keeps answers within the free plan's 8K tokens/minute
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=2048

# --- 2. Embeddings: local fastembed (default, matches the index in the repository) ---
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Optional: Google embeddings instead (REQUIRES rebuilding the index, see RAG_HANDOFF.md §8) ---
# EMBEDDING_PROVIDER=google
# GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# EMBED_BATCH_SIZE=50
# EMBED_MAX_RETRIES=8

# --- Optional alternative LLM (not used by default) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (only when the API is not behind the Vite dev proxy) ---
# VITE_API_URL=https://your-api.example.com
