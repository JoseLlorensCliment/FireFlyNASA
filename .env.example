# Flame Intelligence — copy to .env and fill in. NEVER commit .env.

# --- Generative model (answers of the AI assistant) ---
# Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: low | medium | high  (empty = model default)
GEMINI_THINKING_LEVEL=

# --- Embeddings (RAG retrieval) ---
# google = Gemini API embeddings (uses GEMINI_API_KEY) | local = fastembed on CPU
EMBEDDING_PROVIDER=google
# gemini-embedding-001 (text-only, task types) | gemini-embedding-2 (multimodal, prompt-formatted tasks)
EMBEDDING_MODEL=gemini-embedding-001
# 128-3072; Google recommends 768, 1536 or 3072. MUST be identical when building the index and serving queries.
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=50
EMBED_MAX_RETRIES=8

# --- Legacy option (first prototype) ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (only when the API is not behind the Vite dev proxy) ---
# VITE_API_URL=https://your-api.example.com
