# Flame Intelligence — copy to .env and fill in. NEVER commit .env.
#
# The AI assistant uses TWO different models, both through external APIs (no local AI):
#   1. LLM (writes the chatbot / report answers) ........ Groq      -> GROQ_API_KEY
#   2. Embeddings (turns documents + questions into vectors to SEARCH the NASA corpus)
#      Groq offers no embedding models, so search uses the Google Gemini API -> GEMINI_API_KEY

# --- 1. LLM: Groq (free plan) — https://console.groq.com/keys ---
LLM_PROVIDER=groq
GROQ_API_KEY=
# Free-plan models with JSON output (verified 14 Nov 2026): openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high — low keeps answers within the free plan's 8K tokens/minute
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=2048

# --- 2. Embeddings: Google Gemini API — https://aistudio.google.com/apikey ---
EMBEDDING_PROVIDER=google
GEMINI_API_KEY=
# gemini-embedding-001 (text-only, task types) | gemini-embedding-2 (multimodal, prompt-formatted tasks)
EMBEDDING_MODEL=gemini-embedding-001
# 128-3072; Google recommends 768, 1536 or 3072. MUST be identical when building the index and serving queries.
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=50
EMBED_MAX_RETRIES=8

# --- Optional alternative LLM (not used by default) ---
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.8-flash

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (only when the API is not behind the Vite dev proxy) ---
# VITE_API_URL=https://your-api.example.com
